# Copy to docker.env and replace both values before deployment.
# Percent-encode reserved characters in the username or password.
DATABASE_URL=postgres://serviceops:replace-with-password@database-host:5432/serviceops360?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional host port and application settings.
HTTP_PORT=8080
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s
AUTH_RATE_WINDOW=15m
AUTH_EMAIL_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
