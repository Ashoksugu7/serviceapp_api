# Example only. The application reads process environment, not this file.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://serviceops:change-me@localhost:5432/serviceops360?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s
AUTH_RATE_WINDOW=15m
AUTH_EMAIL_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
# Email (T27). log writes emails to the API log; smtp sends them.
MAIL_MODE=log
MAIL_LOG_BODY=false
MAIL_FROM=ServiceOps360 <no-reply@example.com>
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_TIMEOUT=10s
